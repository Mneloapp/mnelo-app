# Mnelo Development. Private conversation state belongs to participant devices.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_RELAY_URL=ws://127.0.0.1:8084
EXPO_PUBLIC_PHONE_IDENTITY_URL=http://127.0.0.1:8086
# Native migration candidate only; requires matching MNELO_DELIVERY_V2=1 server.
# EXPO_PUBLIC_DELIVERY_V2=1
# Other networks require a reviewed wss signaling deployment and ICE/TURN setup.
# No Supabase, SMS, LiveKit server secrets, identity keys or backup keys belong here.
# Preview / production intentionally fail until the privacy protocol and deployment are reviewed.
