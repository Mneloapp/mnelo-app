# Install as /etc/mnelo/identity.env, root:root 0600. Never use EXPO_PUBLIC for these.
MNELO_HOSTED_IDENTITY=development
# Comma-separated 64-character HMAC indexes from the SAME index.key as the registry.
# Admit only deliberately approved testers with provider eligibility verified. Max 50.
MNELO_ALLOWED_PHONE_INDICES=
# For public launch only, after account-specific coverage and release review:
# set MNELO_HOSTED_IDENTITY=public, remove MNELO_ALLOWED_PHONE_INDICES,
# retain MNELO_COMBINED_RELAY=1 and install a completed owner-only policy file:
# MNELO_PUBLIC_REGISTRATION_POLICY_FILE=/etc/mnelo/public-registration.json
# The empty allowedCountries in public-registration.json.example deliberately
# fails validation. Never replace it with an unverified global country list.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=
