[Unit]
Description=Mnelo development phone verification
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mnelo-identity
Group=mnelo-identity
StateDirectory=mnelo-identity
StateDirectoryMode=0700
WorkingDirectory=/var/lib/mnelo-identity
EnvironmentFile=/etc/mnelo/identity.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node /opt/mnelo/runtime/identity.mjs --infobip
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
LimitCORE=0
LimitNOFILE=1024
MemoryMax=256M
MemorySwapMax=0
TasksMax=64
CPUQuota=100%
OOMPolicy=kill
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
InaccessiblePaths=/tmp /var/tmp /dev/shm
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
SocketBindAllow=tcp:8086

[Install]
WantedBy=multi-user.target
