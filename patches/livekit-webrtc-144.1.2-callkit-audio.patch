+// BEGIN MNELO CALLKIT AUDIO
+- (void)mneloSyncCallKitAudio {
+    // RTCAudioSession calls its delegates under locks. Never synchronously enter
+    // the ADM worker (which can acquire that session lock) from a delegate.
+    __weak WebRTCModule *weakSelf = self;
+    dispatch_async(self.workerQueue, ^{
+        WebRTCModule *module = weakSelf;
+        if (!module) return;
+        RTCAudioSession *session = [RTCAudioSession sharedInstance];
+        if (!session.useManualAudio) return;
+        // Read at execution time, so an old queued activation cannot reopen the
+        // mic after deactivation/end. Tracks and SDP can exist with this gate shut.
+        BOOL available = session.isActive && session.isAudioEnabled;
+        RTCAudioEngineAvailability availability = { available, available };
+        NSInteger result = [module.audioDeviceModule setEngineAvailability:availability];
+        NSDictionary *state = @{ @"available": @(available), @"result": @(result) };
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [[NSNotificationCenter defaultCenter] postNotificationName:@"MneloNativeAudioEngineState"
+                                                                object:nil userInfo:state];
+        });
+    });
+}
+- (void)audioSession:(RTCAudioSession *)session didChangeCanPlayOrRecord:(BOOL)canPlayOrRecord {
+    [self mneloSyncCallKitAudio];
+}
+- (void)audioSession:(RTCAudioSession *)session didSetActive:(BOOL)active {
+    [self mneloSyncCallKitAudio];
+}
+- (void)audioSessionDidBeginInterruption:(RTCAudioSession *)session {
+    [self mneloSyncCallKitAudio];
+}
+- (void)audioSessionDidEndInterruption:(RTCAudioSession *)session shouldResumeSession:(BOOL)shouldResumeSession {
+    [self mneloSyncCallKitAudio];
+}
