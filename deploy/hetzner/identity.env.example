# Install as /etc/mnelo/identity.env, root:root 0600. Never use EXPO_PUBLIC for these.
MNELO_HOSTED_IDENTITY=development
# Comma-separated 64-character HMAC indexes from the SAME index.key as the registry.
# Admit only deliberately approved testers with provider eligibility verified. Max 50.
MNELO_ALLOWED_PHONE_INDICES=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_2FA_APPLICATION_ID=
INFOBIP_2FA_MESSAGE_ID=
