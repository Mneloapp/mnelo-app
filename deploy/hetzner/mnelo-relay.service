[Unit]
Description=Mnelo development transient signaling
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/mnelo/runtime
ExecStart=/usr/local/bin/node /opt/mnelo/runtime/relay.mjs
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
LimitCORE=0
LimitNOFILE=2048
MemoryMax=256M
MemorySwapMax=0
TasksMax=64
CPUQuota=100%
OOMPolicy=kill
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
InaccessiblePaths=/tmp /var/tmp /dev/shm
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
